# ── Required ──────────────────────────────────────────────────────────────────
# Used to sign JWT tokens. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── LLM / AI ──────────────────────────────────────────────────────────────────
# Default: local Ollama. Switch to a cloud model by uncommenting one of these:
# ANDROBUGGER_DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-6
# ANDROBUGGER_DEFAULT_LLM_MODEL=openai/gpt-4o

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Native Linux defaults (loopback) ──────────────────────────────────────────
ANDROBUGGER_OLLAMA_BASE_URL=http://127.0.0.1:11434
ANDROBUGGER_REDIS_URL=redis://127.0.0.1:6379
ANDROBUGGER_DATA_DIR=/var/lib/androbugger
ANDROBUGGER_DB_PATH=/var/lib/androbugger/androbugger.db
ANDROBUGGER_FRONTEND_DIST=/opt/androbugger/frontend/dist

# ── Optional overrides ────────────────────────────────────────────────────────
# ANDROBUGGER_HOST=0.0.0.0
# ANDROBUGGER_PORT=8000
# ANDROBUGGER_DEBUG=false
# ANDROBUGGER_EMBEDDING_MODEL=nomic-embed-text
# ANDROBUGGER_DEFAULT_LLM_MODEL=ollama/qwen3:14b
# ANDROBUGGER_FALLBACK_LLM_MODEL=ollama/qwen3:8b
# ANDROBUGGER_LLM_MAX_TOKENS=4096
# ANDROBUGGER_ACCESS_TOKEN_EXPIRE_HOURS=8
# ANDROBUGGER_REFRESH_TOKEN_EXPIRE_HOURS=24
# ANDROBUGGER_ENABLE_PRIVACY_GATE=true
# ANDROBUGGER_AUDIT_RETENTION_DAYS=90
# ANDROBUGGER_ADB_DEVICE_POLL_INTERVAL=5.0
# ANDROBUGGER_MCP_API_KEY=
# ANDROBUGGER_SMTP_HOST=
# ANDROBUGGER_SMTP_PORT=587
# ANDROBUGGER_SMTP_USERNAME=
# ANDROBUGGER_SMTP_PASSWORD=
# ANDROBUGGER_SMTP_FROM=androbugger@localhost
# ANDROBUGGER_WEBHOOK_RETRY_ATTEMPTS=3
